GEMINI_API_KEY=your_key_here
PORT=3000

# Optional model overrides (defaults are tried in order with automatic fallback)
# GEMINI_SMART_MODEL=gemini-4-argon
# GEMINI_CODE_MODEL=gemini-4-argon   # used by the site builder (defaults to the smart model)
# GEMINI_FAST_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Limits per API key
CHAT_PER_DAY=1000
IMAGES_PER_DAY=50
PER_MINUTE=20

# Site builder
BUILDS_PER_DAY=30      # builds per user per day
MAX_PROJECTS=20        # hosted sites per user
# BUILDER_REVIEW=0     # set to 0 to skip the extra self-review pass (faster, less thorough)

# Production
# COOKIE_SECURE=1
# TRUST_PROXY=1
